{
  "manifest_version": 3,
  "name": "MacroMenu",
  "version": "0.1.0",
  "description": "Find the best menu options for your fitness goal. Local-first prototype using mock data.",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open MacroMenu"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs"]
}
